<%- include("partials/header") %><div class="authbox"><p class="eyebrow">JOIN IMOVIES</p><h1>Create account</h1><% if(typeof error!=="undefined"){ %><p class="error"><%= error %></p><% } %><form method="POST" action="/register"><label>Full name</label><input name="name" required placeholder="Your name"><label>Email</label><input type="email" name="email" required placeholder="you@example.com"><label>Password</label><input type="password" name="password" minlength="6" required placeholder="At least 6 characters"><button class="btn full">Create Account</button></form><p class="muted">Already registered? <a href="/login">Login</a></p></div><%- include("partials/footer") %>