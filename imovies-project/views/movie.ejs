<%- include("partials/header") %><div class="detail"><img class="detailposter" src="<%= movie.poster %>" alt="<%= movie.title %> poster"><div><p class="eyebrow">NOW SHOWING</p><h1><%= movie.title %></h1><p class="muted"><%= movie.genre %> · <%= movie.duration %> · <%= movie.language %></p><p><%= movie.description %></p><h3>Book your show</h3><% if(!user){ %><p><a href="/login">Login</a> to book tickets.</p><% } else { %><form method="POST" action="/book/<%= movie._id %>" id="bookingForm"><label>Select date</label><input type="date" name="showDate" id="showDate" required><label>Select showtime</label><select name="showtime" id="showtime"><% movie.showtimes.forEach(t=>{ %><option value="<%= t %>"><%= t %></option><% }) %></select><label>Choose seats (₹<%= movie.price %> per seat)</label><div class="seatlegend"><span>Available</span><span>Selected</span><span>Booked</span></div><div class="seatmap" id="seatmap"></div><p id="seatCount" class="muted">Select your seats</p><button class="btn" type="submit">Confirm Booking</button></form><% } %></div></div><% if(user){ %><script>window.MOVIE_ID="<%= movie._id %>";</script><script src="/js/seats.js"></script><% } %><%- include("partials/footer") %>