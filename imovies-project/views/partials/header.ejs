<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>IMovies</title><link rel="stylesheet" href="/css/style.css"></head><body><header class="topbar"><a class="brand" href="/">I<span>Movies</span></a><nav><a href="/">Home</a><% if(user){ %><a href="/my-bookings">My Bookings</a><% if(user.email === (process.env.ADMIN_EMAIL || "admin@imovies.com")){ %><a href="/admin">Admin</a><% } %><span class="welcome">Hi, <%= user.name %></span><form class="inline" method="POST" action="/logout"><button class="linkbtn">Logout</button></form><% } else { %><a href="/login">Login</a><a class="navbtn" href="/register">Sign Up</a><% } %></nav></header><main class="container"><% if(notice){ %><p class="notice"><%= notice %></p><% } %>