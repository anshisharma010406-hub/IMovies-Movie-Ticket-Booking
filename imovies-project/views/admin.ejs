<%- include("partials/header") %><p class="eyebrow">ADMIN PANEL</p><h1>Manage Movies</h1><div class="adminbox"><h2>Add a movie</h2><form method="POST" action="/admin/movies" class="adminform"><input name="title" placeholder="Movie title" required><input name="genre" placeholder="Genre"><input name="duration" placeholder="Duration e.g. 2h 10m"><input name="language" placeholder="Language"><input name="poster" placeholder="Poster image URL"><input name="price" type="number" min="1" placeholder="Ticket price" value="150"><input name="showtimes" placeholder="Showtimes, comma separated" value="10:00 AM, 1:30 PM, 6:00 PM"><textarea name="description" placeholder="Movie description"></textarea><button class="btn">Add Movie</button></form></div><h2>Existing movies</h2><% movies.forEach(m=>{ %><div class="adminrow"><span><%= m.title %></span><form method="POST" action="/admin/movies/<%= m._id %>/delete" onsubmit="return confirm('Delete this movie?')"><button class="deletebtn">Delete</button></form></div><% }) %><%- include("partials/footer") %>