<%- include("partials/header") %><p class="eyebrow">YOUR ACCOUNT</p><h1>My Bookings</h1><% if(!bookings.length){ %><p class="muted">You have no bookings yet.</p><a class="btn" href="/">Browse Movies</a><% } %><div class="bookinglist"><% bookings.forEach(b=>{ %><article class="bookingitem"><div><h3><%= b.movie ? b.movie.title : "Movie unavailable" %></h3><p><%= b.showDate %> · <%= b.showtime %></p><p>Seats: <%= b.seats.join(", ") %></p><small>Booking ID: <%= b.bookingCode %></small></div><strong>₹<%= b.total %></strong></article><% }) %></div><%- include("partials/footer") %>